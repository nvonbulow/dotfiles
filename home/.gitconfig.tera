[user]
	email = {{ vars.git_email | json_encode }}
	name = {{ vars.git_name | json_encode }}

{% if os() == "macos" %}
[http]
	sslBackend = secure-transport
{% endif %}

[core]
	# don't page if everything fits on a line
	pager = less -F -X

[gc]
	auto = 0
	reflogExpire = never
	reflogExpireUnreachable = never

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[rerere]
	enabled = 1
